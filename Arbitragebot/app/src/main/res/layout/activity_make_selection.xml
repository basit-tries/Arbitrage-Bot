<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Registeration.ForgetPassword"
    android:background="@color/white"
    android:padding="30dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="41dp"
            android:layout_height="22dp"
            android:src="@drawable/cancel"/>



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make Selection"
            android:textColor="@color/black"
            android:textSize="40sp"
            android:textAllCaps="true"
            android:fontFamily="@font/bungee"
            android:layout_marginTop="30dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make Selection Detail"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/belgrano"
            />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="50dp"
            android:background="@color/white"
            android:padding="10dp">

            <ImageView
                android:id="@+id/mobile_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/mobile_icon"
                android:layout_centerVertical="true"
                android:layout_marginTop="20dp"/>

            <TextView
                android:id="@+id/mobile_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Via SMS"
                android:textColor="@color/black"
                android:textSize="25sp"
                android:fontFamily="@font/belgrano"
                android:layout_toRightOf="@id/mobile_icon"
                android:layout_marginTop="35dp"
                />

            <TextView
                android:id="@+id/mobile_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+923224974174"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:fontFamily="@font/belgrano"
                android:layout_toRightOf="@id/mobile_icon"
                android:layout_below="@id/mobile_title"
                />




        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            android:background="@color/white"
            android:padding="10dp">

            <ImageView
                android:id="@+id/email_icon"
                android:layout_width="72dp"
                android:layout_height="62dp"
                android:layout_centerVertical="true"
                android:layout_marginTop="20dp"
                android:src="@drawable/email_icon" />

            <TextView
                android:id="@+id/email_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="45dp"
                android:layout_toRightOf="@id/email_icon"
                android:fontFamily="@font/belgrano"
                android:text="Via Email"
                android:textColor="@color/black"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/email_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/email_title"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="5dp"
                android:layout_toRightOf="@id/email_icon"
                android:fontFamily="@font/belgrano"
                android:text="butthammad760@gmail.com"

                android:textColor="@color/black"
                android:textSize="20sp" />


        </RelativeLayout>




    </LinearLayout>


</ScrollView>



